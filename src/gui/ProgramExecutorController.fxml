<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.gui.ProgramExecutorController">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="10.0">
            <children>
                <Label text="Number of Program States:" />
                <TextField fx:id="numberOfProgramStatesTextField" editable="false" prefWidth="50.0" />
            </children>
            <padding>
                <Insets left="10.0" />
            </padding>
        </HBox>
        <HBox VBox.vgrow="ALWAYS">
            <children>
                <VBox prefWidth="200.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Heap Table" />
                        <TableView fx:id="heapTableView" prefHeight="200.0" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="addressColumn" prefWidth="75.0" text="Address" />
                                <TableColumn fx:id="valueColumn" prefWidth="125.0" text="Value" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
                <VBox prefWidth="200.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Output" />
                        <ListView fx:id="outputListView" prefHeight="200.0" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>
                <VBox prefWidth="200.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="File Table" />
                        <ListView fx:id="fileTableListView" prefHeight="200.0" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>
                <VBox prefWidth="200.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Program States" />
                        <ListView fx:id="programStateIdentifiersListView" onMouseClicked="#changeProgramState" prefHeight="200.0" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>
                <VBox prefWidth="300.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Barrier Table" />
                        <TableView fx:id="barrierTableView" prefHeight="200.0" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="barrierIndexColumn" prefWidth="50.0" text="Index" />
                                <TableColumn fx:id="barrierValueColumn" prefWidth="50.0" text="Value" />
                                <TableColumn fx:id="barrierListColumn" prefWidth="200.0" text="List" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </HBox>
        <HBox VBox.vgrow="ALWAYS">
            <children>
                <VBox prefWidth="200.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Symbol Table" />
                        <TableView fx:id="symbolTableView" prefHeight="200.0" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="variableNameColumn" prefWidth="75.0" text="Var Name" />
                                <TableColumn fx:id="variableValueColumn" prefWidth="125.0" text="Value" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
                <VBox prefWidth="200.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Execution Stack" />
                        <ListView fx:id="executionStackListView" prefHeight="200.0" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>
            </children>
        </HBox>
        <HBox alignment="CENTER" prefHeight="50.0">
            <children>
                <Button fx:id="runOneStepButton" onMouseClicked="#runOneStep" text="Run One Step" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</VBox>
